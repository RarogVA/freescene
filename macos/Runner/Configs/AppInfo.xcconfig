// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = FreeScene
ARCHS = arm64
FREESCENE_NATIVE_DIR = native

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = local.freescene.freescene

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Rar0g.

// Native engine and libVLC are prepared by the Build Native phase.
SWIFT_OBJC_BRIDGING_HEADER = Runner/Runner-Bridging-Header.h
HEADER_SEARCH_PATHS = $(inherited) "$(PROJECT_DIR)/../build/$(FREESCENE_NATIVE_DIR)/include"
LIBRARY_SEARCH_PATHS = $(inherited) "$(PROJECT_DIR)/../build/$(FREESCENE_NATIVE_DIR)" "$(PROJECT_DIR)/../build/$(FREESCENE_NATIVE_DIR)/vlc/lib"
OTHER_LDFLAGS = $(inherited) -framework UserNotifications -framework UniformTypeIdentifiers -framework CoreText -framework CoreGraphics -framework QuartzCore -framework Security -framework WebKit -lFreeSceneEngine -lvlc -Wl,-rpath,@executable_path/../Resources/VLC/lib
CLANG_CXX_LANGUAGE_STANDARD = c++17
